{
  "$schema": "Fuente unica de verdad del sistema de diseno Aura. design-system/generate.py la lee y produce los assets del firmware.",
  "screen": { "width": 320, "height": 240 },
  "layout": { "statusbar_height": 20 },

  "color": {
    "light": {
      "background": "#FFFFFF",
      "surface": "#F2F2F2",
      "text_primary": "#0A0A0A",
      "text_secondary": "#6B6B6B",
      "border": "#E0E0E0",
      "accent": "#FF3B30",
      "accent_on": "#FFFFFF"
    },
    "dark": {
      "background": "#000000",
      "surface": "#1C1C1E",
      "text_primary": "#FFFFFF",
      "text_secondary": "#9A9A9A",
      "border": "#2C2C2E",
      "accent": "#FF453A",
      "accent_on": "#000000"
    }
  },

  "spacing": {
    "xs": 2,
    "sm": 4,
    "md": 8,
    "lg": 12,
    "xl": 16,
    "xxl": 24
  },

  "type_scale": {
    "title": 20,
    "body": 14,
    "caption": 11,
    "micro": 9
  },

  "font": {
    "family": "Inter",
    "license": "SIL Open Font License 1.1",
    "source_repo": "https://github.com/rsms/inter",
    "weights": {
      "regular": "Inter-Regular.ttf",
      "medium": "Inter-Medium.ttf",
      "semibold": "Inter-SemiBold.ttf"
    },
    "styles_by_size": {
      "title": "semibold",
      "body": "regular",
      "caption": "regular",
      "micro": "medium"
    }
  },

  "icon": {
    "family": "Lucide",
    "license": "ISC",
    "source_repo": "https://github.com/lucide-icons/lucide",
    "sizes": {
      "menu": 20,
      "status": 12
    },
    "stroke_width": 1.75,
    "names": [
      "music",
      "video",
      "image",
      "play",
      "pause",
      "settings",
      "chevron-right",
      "chevron-left",
      "check",
      "battery-full",
      "battery-medium",
      "battery-low",
      "battery-charging",
      "lock",
      "volume-2",
      "sun",
      "globe",
      "info",
      "sliders-horizontal"
    ]
  }
}
