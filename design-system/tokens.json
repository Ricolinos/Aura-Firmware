{
  "$schema": "Fuente unica de verdad del sistema de diseno Aura. design-system/generate.py la lee y produce los assets del firmware.",
  "screen": { "width": 320, "height": 240 },
  "layout": { "statusbar_height": 20, "panel_left_width": 168 },

  "color": {
    "light": {
      "background": "#FFFFFF",
      "surface": "#F7F7F7",
      "text_primary": "#0A0A0A",
      "text_secondary": "#6B6B6B",
      "border": "#E0E0E0",
      "accent": "#F21B33",
      "selection": "#EFEFEF",
      "on_selection": "#F21B33"
    },
    "dark": {
      "background": "#000000",
      "surface": "#1C1C1E",
      "text_primary": "#FFFFFF",
      "text_secondary": "#9A9A9A",
      "border": "#2C2C2E",
      "accent": "#F21B33",
      "selection": "#2C2C2E",
      "on_selection": "#F21B33"
    }
  },

  "spacing": {
    "xs": 2,
    "sm": 4,
    "md": 8,
    "lg": 12,
    "xl": 16,
    "xxl": 24
  },

  "type_scale": {
    "title": 20,
    "body": 16,
    "caption": 12,
    "micro": 9
  },

  "font": {
    "family": "SF Pro",
    "license": "Apple. NO se versiona en este repo: generate.py la lee de la instalacion local del sistema. Descarga oficial: https://developer.apple.com/fonts/",
    "search_paths": [
      "/Library/Fonts",
      "~/Library/Fonts",
      "/System/Library/Fonts"
    ],
    "comment_optical_sizes": "SF Pro Text esta disenada para <=19pt y SF Pro Display para >=20pt; el reparto de abajo respeta esa regla de Apple.",
    "faces": {
      "text_regular": "SF-Pro-Text-Regular.otf",
      "text_medium": "SF-Pro-Text-Medium.otf",
      "display_semibold": "SF-Pro-Display-Semibold.otf"
    },
    "styles_by_size": {
      "title": "display_semibold",
      "body": "text_regular",
      "caption": "text_regular",
      "micro": "text_medium"
    }
  },

  "icon": {
    "family": "SF Symbols",
    "license": "Apple. NO se versiona en este repo: generate.py los renderiza desde el sistema via AppKit (scripts/render_sf_symbols.swift).",
    "sizes": {
      "menu": 20,
      "status": 12,
      "preview": 48
    },
    "weight_by_size": {
      "menu": "medium",
      "status": "semibold",
      "preview": "regular"
    },
    "comment_weights": "A 12px el umbral de alfa se come los trazos finos, por eso la barra de estado usa semibold; el preview de 48px puede permitirse regular.",
    "names": {
      "music": "music.note",
      "video": "film.fill",
      "image": "photo.fill",
      "play": "play.fill",
      "pause": "pause.fill",
      "settings": "gearshape.fill",
      "chevron-right": "chevron.right",
      "chevron-left": "chevron.left",
      "check": "checkmark",
      "battery-full": "battery.100",
      "battery-medium": "battery.50",
      "battery-low": "battery.25",
      "battery-charging": "battery.100.bolt",
      "lock": "lock.fill",
      "volume-2": "speaker.wave.2.fill",
      "sun": "sun.max.fill",
      "globe": "globe",
      "info": "info.circle",
      "sliders-horizontal": "slider.horizontal.3"
    },
    "variants": {
      "": "text_primary",
      "-on": "on_selection"
    },
    "comment_variants": "Cada icono se genera dos veces: en el color de texto normal y en el color de contraste, para la fila activa (el bitmap ya viene coloreado, ver D-010)."
  }
}
