# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Builds del firmware (simulador y target)
firmware/build*/
firmware/rockbox/build*/

# Toolchain ARM y artefactos de rockboxdev.sh
firmware/toolchain/
/tmp-rbdev*/

# Fixtures de audio/foto/video de prueba (regenerar con firmware/tools/gen_test_media.sh)
firmware/test-media/

# Binarios de los tests host-side (make -C firmware/rockbox/apps/aura/test test)
firmware/rockbox/apps/aura/test/build/

# Salida generada del design system (regenerar con design-system/generate.py)
design-system/out/
design-system/.venv/
__pycache__/
*.pyc

# Artefactos empaquetados del firmware (regenerar con firmware/tools/package_dist.sh,
# publicar como GitHub Release -- ver firmware/dist/README.md). Nunca se versionan
# aquí: son binarios de varios MB y el historial ya se limpió una vez por esto.
firmware/dist/*.zip
firmware/dist/*.ipod
firmware/dist/mks5lboot
firmware/dist/checksums.txt
firmware/dist/AuraPalette.swift
firmware/dist/MODIFICATIONS.md
# Copiado desde design-system/out/ por firmware/tools/build_sim.sh
firmware/rockbox/apps/aura/apple2026_tokens.h

# Xcode
studio/**/DerivedData/
studio/**/xcuserdata/
studio/**/*.xcuserstate
studio/**/build/
*.xcworkspace/xcuserdata/

# Swift Package Manager
.build/
.swiftpm/

# Archivos temporales
*.log
*.tmp
*.swp
